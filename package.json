{
  "name": "vaniscript",
  "version": "1.0.0",
  "description": "Gaudiya Vaishnava Lecture Transcription & Translation Engine",
  "author": "Stichting Kadamba Foundation",
  "private": true,
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "vite-build": "vite build",
    "compile": "tsc --noEmit",
    "perf:ci": "node --expose-gc --import tsx scripts/run-p4d3-perf.mjs",
    "pretest": "node test/parity/parity-gate.mjs",
    "test": "node scripts/run-electron-tests.mjs",
    "test:e2e": "playwright test",
    "qualify:release": "npm run build:release:unsigned && node scripts/check-release-content.mjs && node scripts/boot-smoke.mjs && npm run test:e2e && node scripts/generate-qualification-report.mjs",
    "electron": "npm run vite-build && npm run prepare-dev-branding && node_modules/electron/dist/Electron.app/Contents/MacOS/Electron .",
    "start": "npm run electron",
    "build": "npm run vite-build && electron-builder --mac",
    "build:win": "npm run vite-build && electron-builder --win",
    "build:linux": "npm run vite-build && electron-builder --linux",
    "build:ci": "npm run vite-build && electron-builder --dir --c.mac.identity=null",
    "build:release:unsigned": "npm run vite-build && node scripts/fetch-vendor-binaries.mjs && electron-builder --c.mac.identity=null --publish never",
    "build:release:signed": "npm run vite-build && node scripts/fetch-vendor-binaries.mjs && if [ \"${CSC_IDENTITY_AUTO_DISCOVERY:-}\" = \"false\" ]; then electron-builder --mac --arm64 --publish never --c.mac.identity=null; else electron-builder --mac --arm64 --publish never; fi",
    "verify:release": "node scripts/verify-release-artifacts.mjs",
    "pack": "npm run vite-build && electron-builder --dir",
    "pack:unsigned": "npm run vite-build && electron-builder --dir --c.mac.identity=null",
    "rebuild": "electron-rebuild",
    "test:identity": "node scripts/verify-release-identity.mjs",
    "install:llamacpp-runtime": "node scripts/install-llamacpp-runtime.mjs",
    "prepare-dev-branding": "node scripts/prepare-dev-electron-branding.mjs"
  },
  "build": {
    "appId": "com.gaudiya.vaniscript",
    "productName": "VaniScript-Electron",
    "publish": {
      "provider": "github",
      "owner": "Pavan-Gopa",
      "repo": "VaniScript-Electron"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "assets/**/*",
      "src/render-engine/**/*",
      "src/lib/subtitle-alignment.ts",
      "src/lib/shorts-render.ts",
      "node_modules/**/*",
      "!node_modules/ffmpeg-static/bin/win32/**",
      "!node_modules/ffmpeg-static/bin/linux/**"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/@kutalia/whisper-node-addon/**"
    ],
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "artifactName": "VaniScript-Electron.${ext}",
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "identity": "Stichting Kadamba Foundation (438UQRF7JV)",
      "hardenedRuntime": true,
      "entitlements": "scripts/entitlements.mac.plist",
      "entitlementsInherit": "scripts/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": false
    },
    "win": {
      "target": "nsis-web",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "maintainer": "Stichting Kadamba Foundation <Pavan-Gopa@users.noreply.github.com>"
    },
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/",
        "to": "ffmpeg-bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/llamacpp/",
        "to": "llamacpp",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/yt-dlp/",
        "to": "yt-dlp-bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterSign": "scripts/notarize.mjs"
  },
  "dependencies": {
    "@fontsource/cuprum": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@hyperframes/producer": "^0.5.7",
    "@kutalia/whisper-node-addon": "^1.0.0",
    "better-sqlite3": "^12.11.1",
    "electron-log": "^5.2.4",
    "ffmpeg-static": "^5.2.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prosemirror-history": "^1.5.0",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.2.1",
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "electron": "^34.0.0",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9",
    "jsdom": "^30.0.1",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
